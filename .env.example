# ==============================================
# AquaCare Water Purifier Showcase & Services
# Root / Backend Environment Variables
# ==============================================

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/water_purifier_db

# Security & Authentication
JWT_SECRET=aquaCare_super_secret_jwt_key_change_in_production_2026
COOKIE_SECRET=aquaCare_super_secret_cookie_key_32_characters_min
CORS_ORIGIN=http://localhost:5173

# Admin Bootstrap (Used during initial seeding)
ADMIN_NAME=Admin AquaCare
ADMIN_EMAIL=admin@aquaCare.com
ADMIN_PASSWORD=Admin@123456

# Cloudinary Configuration (Optional for local testing; placeholder/direct URLs supported)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================
# Frontend Environment Variables (Vite)
# (Copy to apps/web/.env as well)
# ==============================================
VITE_API_BASE_URL=http://localhost:5000/api/v1
